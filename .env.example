# Copy to .env.local (git-ignored). Never commit real keys.

# Required. Server-side only; never exposed to the browser.
SARVAM_API_KEY=

# Optional. Defaults to sarvam-105b.
# SARVAM_MODEL=sarvam-105b

# Optional. Reasoning effort: none | low | medium | high. Defaults to low.
# "none" is fastest and cheapest; try it if outlines keep timing out.
# SARVAM_REASONING=low

# Optional. If the model answers the outline step with prose instead of tool
# calls, nudge it once (costs one extra call in that case only). Off by default.
# AGENT_RETRY_ON_TEXT=1
